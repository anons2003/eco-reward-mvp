# App
APP_NAME="Eco-Reward MVP"
APP_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Demo authentication
ADMIN_EMAIL="anons2003+eco-admin@gmail.com"
ADMIN_PASSWORD="EcoReward123!"

# AI provider: mock or roboflow
AI_PROVIDER="mock"
ROBOFLOW_API_KEY="your-roboflow-api-key"
ROBOFLOW_MODEL_ID="your-project/version"
ROBOFLOW_API_URL="https://serverless.roboflow.com"

# Storage
SUBMISSION_IMAGE_BUCKET="waste-submissions"
AWS_REGION="ap-southeast-1"
S3_AVATAR_BUCKET="your-avatar-bucket"
S3_AVATAR_PUBLIC_BASE_URL="https://your-avatar-cdn-or-bucket-url"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# QR and anti-fraud rules
QR_SESSION_TTL_SECONDS=120
MAX_SUBMISSIONS_PER_USER_PER_DAY=10
MIN_AI_CONFIDENCE=0.75
GPS_RADIUS_METERS=50

# Smart bin integration, optional for demo
SMART_BIN_WEBHOOK_SECRET="change-me"
SMART_BIN_API_BASE_URL="https://example.com/api"
