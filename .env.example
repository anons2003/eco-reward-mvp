# App
APP_NAME="Waste Sorting Rewards"
APP_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Authentication
JWT_SECRET="change-me"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Roboflow AI
ROBOFLOW_API_KEY="your-roboflow-api-key"
ROBOFLOW_MODEL_ID="your-project/version"
ROBOFLOW_API_URL="https://serverless.roboflow.com"

# Storage for waste submission images
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="waste-submissions"
R2_PUBLIC_URL="https://example.com"

# QR and anti-fraud rules
QR_SESSION_TTL_SECONDS=120
QR_SIGNING_SECRET="change-me"
MAX_SUBMISSIONS_PER_USER_PER_DAY=10
MIN_AI_CONFIDENCE=0.75
GPS_RADIUS_METERS=50

# Smart bin integration, optional for demo
SMART_BIN_WEBHOOK_SECRET="change-me"
SMART_BIN_API_BASE_URL="https://example.com/api"
